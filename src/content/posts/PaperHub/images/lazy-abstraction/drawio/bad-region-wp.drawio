<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="bad-region-wp" name="bad-region-wp">
    <mxGraphModel dx="828" dy="700" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="828" pageHeight="700" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="828" height="700" as="geometry" />
        </mxCell>
        <mxCell id="title" value="坏区域的反向回推：从 ERROR 到 pivot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=20;fontColor=#2F5D8A;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="18" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="箭头向下表示反向执行；每个 Bᵢ 都是能沿当前反例后缀到达 ERROR 的精确状态集合" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=14;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="50" width="760" height="24" as="geometry" />
        </mxCell>

        <mxCell id="panel" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBFBFB;strokeColor=#D0D0D0;strokeWidth=1.2;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="24" y="88" width="780" height="584" as="geometry" />
        </mxCell>

        <mxCell id="row-err-badge" value="&lt;b&gt;ERROR&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3E1E1;strokeColor=#9B4A4A;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="48" y="108" width="82" height="48" as="geometry" />
        </mxCell>
        <mxCell id="row-err-formula" value="&lt;b&gt;B&lt;sub&gt;err&lt;/sub&gt; = ⊤&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;错误位置的数据部分没有额外约束（全集）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E1E1;strokeColor=#9B4A4A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="142" y="108" width="638" height="48" as="geometry" />
        </mxCell>

        <mxCell id="arrow-1" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.4;strokeColor=#A85D3A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="row-err-badge" target="row-6-badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="op-1" value="&lt;b&gt;unlock()&lt;/b&gt;　错误分支要求 LOCK = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="146" y="158" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="row-6-badge" value="&lt;b&gt;6&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="48" y="186" width="82" height="48" as="geometry" />
        </mxCell>
        <mxCell id="row-6-formula" value="&lt;b&gt;B&lt;sub&gt;6&lt;/sub&gt; = LOCK = 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;再次调用 unlock() 的状态&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="142" y="186" width="638" height="48" as="geometry" />
        </mxCell>

        <mxCell id="arrow-2" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.4;strokeColor=#4A4A4A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="row-6-badge" target="row-5-badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="op-2" value="&lt;b&gt;assume(new = old)&lt;/b&gt;　把循环退出条件合入坏区域" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="146" y="236" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="row-5-badge" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="48" y="264" width="82" height="48" as="geometry" />
        </mxCell>
        <mxCell id="row-5-formula" value="&lt;b&gt;B&lt;sub&gt;5&lt;/sub&gt; = LOCK = 0 ∧ new = old&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;B&lt;sub&gt;6&lt;/sub&gt; 与退出条件取交集&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="142" y="264" width="638" height="48" as="geometry" />
        </mxCell>

        <mxCell id="arrow-3" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.4;strokeColor=#4A4A4A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="row-5-badge" target="row-4-badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="op-3" value="&lt;b&gt;unlock(); new++&lt;/b&gt;　先撤销 new++，再撤销 unlock()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="146" y="314" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="row-4-badge" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="48" y="342" width="82" height="48" as="geometry" />
        </mxCell>
        <mxCell id="row-4-formula" value="&lt;b&gt;B&lt;sub&gt;4&lt;/sub&gt; = LOCK = 1 ∧ new + 1 = old&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unlock 成功要求 LOCK = 1&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="142" y="342" width="638" height="48" as="geometry" />
        </mxCell>

        <mxCell id="arrow-4" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.4;strokeColor=#4A4A4A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="row-4-badge" target="row-3-badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="op-4" value="&lt;b&gt;assume(true)&lt;/b&gt;　非确定分支，不改变数据条件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="146" y="392" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="row-3-badge" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="48" y="420" width="82" height="48" as="geometry" />
        </mxCell>
        <mxCell id="row-3-formula" value="&lt;b&gt;B&lt;sub&gt;3&lt;/sub&gt; = LOCK = 1 ∧ new + 1 = old&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;B&lt;sub&gt;3&lt;/sub&gt; = B&lt;sub&gt;4&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="142" y="420" width="638" height="48" as="geometry" />
        </mxCell>

        <mxCell id="arrow-5" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.4;strokeColor=#4A4A4A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="row-3-badge" target="row-2-badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="op-5" value="&lt;b&gt;lock(); old = new&lt;/b&gt;　先撤销 old = new，再撤销 lock()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="146" y="470" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="row-2-badge" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5E7DB;strokeColor=#A85D3A;strokeWidth=1.3;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="48" y="498" width="82" height="48" as="geometry" />
        </mxCell>
        <mxCell id="row-2-formula" value="&lt;b&gt;B&lt;sub&gt;2&lt;/sub&gt; = LOCK = 0 ∧ new + 1 = new&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;old 被 new 替换；lock 成功要求 LOCK = 0&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5E7DB;strokeColor=#A85D3A;strokeWidth=1.3;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="142" y="498" width="638" height="48" as="geometry" />
        </mxCell>

        <mxCell id="conclusion" value="&lt;b&gt;new + 1 = new 在整数中不可满足&lt;/b&gt;　→　B&lt;sub&gt;2&lt;/sub&gt; 为空，位置 2 是 pivot" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E1E1;strokeColor=#9B4A4A;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="142" y="574" width="638" height="44" as="geometry" />
        </mxCell>
        <mxCell id="conclusion-arrow" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.3;strokeColor=#9B4A4A;endArrow=block;endFill=1;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="row-2-formula" target="conclusion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="WP 规则：wp(x = e, Q) = Q[e/x]　·　wp(assume(c), Q) = c ∧ Q　·　wp(s₁; s₂, Q) = wp(s₁, wp(s₂, Q))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=10;fontColor=#506472;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="682" width="780" height="14" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
