<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="focus-contract" name="focus-contract">
    <mxGraphModel dx="828" dy="510" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="828" pageHeight="510" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="828" height="510" as="geometry" />
        </mxCell>
        <mxCell id="title" value="focus 算子：一份精化契约" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=20;fontColor=#2F5D8A;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="18" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="输入一个区域、一条反例后缀和错误区域，输出同集合但更精确的区域" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=14;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="50" width="740" height="24" as="geometry" />
        </mxCell>

        <mxCell id="input-card" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="24" y="96" width="190" height="196" as="geometry" />
        </mxCell>
        <mxCell id="input-title" value="输入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#2F5D8A;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="input-r" value="&lt;b&gt;r = (W, F)&lt;/b&gt;&lt;br&gt;当前区域" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="38" y="138" width="162" height="44" as="geometry" />
        </mxCell>
        <mxCell id="input-sigma" value="&lt;b&gt;σ&lt;/b&gt;：反例后缀&lt;br&gt;lock(); old = new; …" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="38" y="192" width="162" height="44" as="geometry" />
        </mxCell>
        <mxCell id="input-eps" value="&lt;b&gt;ε&lt;/b&gt;：错误区域&lt;br&gt;已经与 r 精确回推不相交" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="38" y="246" width="162" height="36" as="geometry" />
        </mxCell>

        <mxCell id="arrow1" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.3;strokeColor=#4A4A4A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="input-card" target="proof-card">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="proof-card" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFBFB;strokeColor=#D0D0D0;strokeWidth=1.2;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="252" y="96" width="330" height="196" as="geometry" />
        </mxCell>
        <mxCell id="proof-title" value="证明生成器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#2F5D8A;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="262" y="104" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="proof-1" value="① 带版本的精确前驱&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;old′ = new ∧ new′ = new+1 ∧ new′ = old′&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="266" y="136" width="302" height="34" as="geometry" />
        </mxCell>
        <mxCell id="proof-2" value="② 与 r 合取，交给定理证明器&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;r ∧ wp(ε, σ) 是 UNSAT&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F3E1E1;strokeColor=#9B4A4A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="266" y="176" width="302" height="34" as="geometry" />
        </mxCell>
        <mxCell id="proof-3" value="③ 从证明里收集真正用到的原子公式&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;H = {old′ = new, new′ = new+1, new′ = old′}&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="266" y="216" width="302" height="34" as="geometry" />
        </mxCell>
        <mxCell id="proof-4" value="④ 去掉版本标记&lt;br&gt;&lt;b&gt;new = old&lt;/b&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F5E7DB;strokeColor=#A85D3A;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="266" y="256" width="302" height="28" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.3;strokeColor=#4A4A4A;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="proof-card" target="output-card">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="output-card" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E5EFE7;strokeColor=#4F7658;strokeWidth=1.3;" vertex="1" parent="1">
          <mxGeometry x="614" y="96" width="190" height="196" as="geometry" />
        </mxCell>
        <mxCell id="output-title" value="输出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=15;fontColor=#4F7658;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="624" y="104" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="output-r" value="&lt;b&gt;r′ = (W′, F′)&lt;/b&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=13;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="628" y="138" width="162" height="36" as="geometry" />
        </mxCell>
        <mxCell id="output-w" value="&lt;b&gt;W′ = W&lt;/b&gt;&lt;br&gt;具体状态集合不变" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="628" y="182" width="162" height="36" as="geometry" />
        </mxCell>
        <mxCell id="output-f" value="&lt;b&gt;F′ = F ∪ {new = old}&lt;/b&gt;&lt;br&gt;支撑谓词更多" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AAAB5;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="628" y="226" width="162" height="36" as="geometry" />
        </mxCell>
        <mxCell id="output-note" value="抽象 post(r′,σ) ∩ ε = ⊥" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=11;fontColor=#4F7658;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="628" y="266" width="162" height="20" as="geometry" />
        </mxCell>

        <mxCell id="contract-card" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5D8A;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="24" y="320" width="780" height="126" as="geometry" />
        </mxCell>
        <mxCell id="contract-title" value="契约：对任意区域 r、反例后缀 σ 和错误区域 ε" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=14;fontColor=#2F5D8A;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="328" width="720" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;r′ ≡ r&lt;/b&gt;&lt;br&gt;不改变具体状态集合" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2F5D8A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;r′ ≤p r&lt;/b&gt;&lt;br&gt;抽象精度不降低" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E5EFE7;strokeColor=#4F7658;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="294" y="360" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;pre(ε,σ) ∩ r = ⊥&lt;br&gt;⇒ 抽象 post(r′,σ) ∩ ε = ⊥&lt;/b&gt;&lt;br&gt;原伪反例被排除" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F5E7DB;strokeColor=#A85D3A;strokeWidth=1.1;fontFamily=Noto Serif CJK SC;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="548" y="360" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="contract-note" value="前两条保证“没有丢掉真实状态”，第三条保证“这次精化确实排除了这条反例”。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#506472;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="418" width="748" height="20" as="geometry" />
        </mxCell>

        <mxCell id="bottom-note" value="注意：focus 增加的是 F，不是给 W 再加一个合取项。W 不变，后续抽象后继却能利用新谓词。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Noto Serif CJK SC;fontSize=12;fontColor=#A85D3A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="24" y="466" width="780" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
