<mxfile host="app.diagrams.net">
  <diagram id="alignment" name="alignment">
    <mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="{height}" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="900" height="{height}" as="geometry" />
        </mxCell>
<mxCell id="sA" value='&lt;div style="line-height:1.7"&gt;&lt;span style="font-family:Times New Roman;font-size:21px;font-style:italic"&gt;A&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = 2z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = 2y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="190" height="150" as="geometry"/></mxCell><mxCell id="sB" value='&lt;div style="line-height:1.7"&gt;&lt;span style="font-family:Times New Roman;font-size:21px;font-style:italic"&gt;B&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = 2z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; − 1&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = 2y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; + x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="355" y="70" width="190" height="150" as="geometry"/></mxCell><mxCell id="sA2" value='&lt;div style="line-height:1.7"&gt;&lt;span style="font-family:Times New Roman;font-size:21px;font-style:italic"&gt;A′&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = x&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = 2z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:18px"&gt;y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = 2y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=17;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="670" y="70" width="190" height="150" as="geometry"/></mxCell><mxCell id="eAB" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sA" target="sB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eBA2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sB" target="sA2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lAB" value="{1}" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="235" y="105" width="80" height="20" as="geometry"/></mxCell><mxCell id="lAB2" value="只推进 v1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=12.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="235" y="148" width="80" height="18" as="geometry"/></mxCell><mxCell id="lBA2" value="{1,2}" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="550" y="105" width="80" height="20" as="geometry"/></mxCell><mxCell id="lBA22" value="两份各一轮" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=12.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="550" y="148" width="80" height="18" as="geometry"/></mxCell><mxCell id="loop" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="sA2" target="sA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="300"/><mxPoint x="135" y="300"/></Array></mxGeometry></mxCell><mxCell id="loopLabel" value='z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; &amp;gt; 0' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="390" y="270" width="120" height="22" as="geometry"/></mxCell><mxCell id="dot" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="447" y="297" width="6" height="6" as="geometry"/></mxCell><mxCell id="exit" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dot" target="exitBox"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="exitCond" value='z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; = 0' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="305" width="80" height="18" as="geometry"/></mxCell><mxCell id="exitBox" value='&lt;div style="line-height:1.5"&gt;&lt;span style="font-family:Times New Roman;font-size:14px"&gt;z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; = 0：退出循环&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:Times New Roman;font-size:14px"&gt;y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; ← 2y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;，得到 y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="335" width="360" height="52" as="geometry"/></mxCell><mxCell id="note" value='A、B、A′ 只含线性关系；无需分别求 &lt;span style="font-family:Times New Roman;font-size:12px"&gt;y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt; = x(2x − z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;1&lt;/span&gt;)&lt;/span&gt; 与 &lt;span style="font-family:Times New Roman;font-size:12px"&gt;y&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt; = x(x − z&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;2&lt;/span&gt;)&lt;/span&gt;。' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="840" height="20" as="geometry"/></mxCell>      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
