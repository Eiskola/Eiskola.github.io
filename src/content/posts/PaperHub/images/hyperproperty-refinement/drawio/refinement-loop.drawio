<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="refinement-loop" name="refinement-loop">
    <mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="{height}" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="900" height="{height}" as="geometry" />
        </mxCell>
<mxCell id="start" value="输入 Π，令 P := ∅" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="300" height="46" as="geometry"/></mxCell><mxCell id="construct" value='构造抽象编码 Π&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;P&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="115" width="300" height="50" as="geometry"/></mxCell><mxCell id="solveAbs" value='求解 Π&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;P&lt;/span&gt;（Z3 / Spacer）' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="300" height="50" as="geometry"/></mxCell><mxCell id="dag" value="得到抽象反驳 DAG G" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="275" width="300" height="50" as="geometry"/></mxCell><mxCell id="refine" value='&lt;div style="line-height:1.35"&gt;按 G 构造非递归精化 CHC Π&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;R&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#444444"&gt;无递归，仍可能非线性&lt;/span&gt;&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="300" height="64" as="geometry"/></mxCell><mxCell id="solveRef" value='求解 Π&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;R&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="300" height="50" as="geometry"/></mxCell><mxCell id="feedback" value='&lt;div style="line-height:1.35"&gt;收集 I&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;v&lt;/span&gt; 解释中的原子公式&lt;br&gt;&lt;span style="font-size:13px;color:#444444"&gt;可选：泛化、筛选后加入 P&lt;/span&gt;&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="525" width="300" height="60" as="geometry"/></mxCell><mxCell id="safe" value="性质成立" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="190" width="180" height="46" as="geometry"/></mxCell><mxCell id="unsafe" value="性质不成立" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.8;fontFamily=Noto Serif CJK SC;fontSize=15.5;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="440" width="180" height="46" as="geometry"/></mxCell><mxCell id="a1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="construct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="construct" target="solveAbs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="solveAbs" target="dag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dag" target="refine"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="refine" target="solveRef"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="solveRef" target="feedback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="solveAbs" target="safe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a8" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="solveRef" target="unsafe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a9" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;endSize=6;rounded=0;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="feedback" target="construct"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="555"/><mxPoint x="150" y="140"/></Array></mxGeometry></mxCell><mxCell id="l1" value="SAT" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="612" y="192" width="50" height="18" as="geometry"/></mxCell><mxCell id="l2" value="UNSAT" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="460" y="249" width="60" height="18" as="geometry"/></mxCell><mxCell id="l3" value="UNSAT" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="612" y="442" width="50" height="18" as="geometry"/></mxCell><mxCell id="l4" value="SAT" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12.5;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="460" y="499" width="50" height="18" as="geometry"/></mxCell><mxCell id="loopNote" value="扩充 P 后重试" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="328" width="115" height="20" as="geometry"/></mxCell><mxCell id="note3" value='Π&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;P&lt;/span&gt; 的 SAT 表示性质成立；Π&lt;span style="font-size:70%;vertical-align:-0.2em"&gt;R&lt;/span&gt; 的 SAT 表示反驳虚假并给出新谓词。' style="text;html=1;align=center;verticalAlign=middle;fontFamily=Noto Serif CJK SC;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="607" width="840" height="20" as="geometry"/></mxCell>      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
