---
import { siteConfig, themeConfig } from "../config";
import { SITE } from "../consts";
import { buildThemeCss } from "../styles/theme-css";
import CategoryBar from "../components/CategoryBar.astro";
import FootnoteTooltip from "../components/FootnoteTooltip.astro";
import Header from "../components/Header.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import "../styles/global.css";

interface Props {
  pageTitle?: string;
  pageDescription?: string;
}

const { pageTitle, pageDescription } = Astro.props;

const title = pageTitle ? `${pageTitle} | ${SITE.title}` : SITE.title;
const description = pageDescription || SITE.description;
const url = new URL(Astro.url.pathname, SITE.url).href;

const themeCss = buildThemeCss();
const themeInit = `(function () {
  var theme = null;
  try { theme = localStorage.getItem(${JSON.stringify(themeConfig.storageKey)}); } catch (e) {}
  if (!theme || ${JSON.stringify(themeConfig.order)}.indexOf(theme) === -1) {
    theme = ${JSON.stringify(themeConfig.defaultTheme)};
  }
  if (theme && theme !== "light") {
    document.documentElement.setAttribute("data-theme", theme);
  }
})();`;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="icon" href={siteConfig.favicon} type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16/dist/katex.min.css" />
    <title>{title}</title>

    <style is:inline set:html={themeCss} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={pageTitle ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={siteConfig.locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <ScrollProgress />
    <Header />
    <CategoryBar />
    <main>
      <slot />
    </main>
    <ImageLightbox />
    <FootnoteTooltip />
  </body>
</html>
