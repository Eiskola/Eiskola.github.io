---
import BackToTop from "../components/BackToTop.astro";
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout>
  <article class="md-page">
    <h1>{frontmatter.title}</h1>
    <div class="md-body">
      <slot />
    </div>
  </article>
  <BackToTop />
</BaseLayout>

<style>
  .md-page h1 {
    margin-top: 0;
  }

  .md-body {
    margin-top: 1.5rem;
  }
</style>
