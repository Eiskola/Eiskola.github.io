---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const catSet = new Set<string>();
  for (const post of posts) {
    if (post.data.draft) continue;
    if (post.data.category) catSet.add(post.data.category);
  }
  return [...catSet].map((cat) => ({ params: { category: cat } }));
}

const { category } = Astro.params;
const allPosts = await getCollection("posts");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout>
  <article class="cat-page">
    <h1>{category}</h1>
    <p class="cat-subtitle">{posts.length} 篇文章</p>

    <ul class="cat-posts">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}`}>
            <time datetime={post.data.published.toISOString()}>
              {post.data.published.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
              })}
            </time>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .cat-page h1 {
    margin-top: 0;
    text-transform: capitalize;
  }

  .cat-subtitle {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0.25rem 0 2rem;
  }

  .cat-posts {
    list-style: none;
    padding: 0;
  }

  .cat-posts li {
    margin-bottom: 0.75rem;
  }

  .cat-posts a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    color: var(--color-text);
  }

  .cat-posts a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .cat-posts time {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
