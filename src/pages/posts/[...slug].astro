---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackToTop from "../../components/BackToTop.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import CommentSection from "../../components/CommentSection.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Reading time: ~400 chars/min for mixed Chinese/English
const charCount = (post.body || "").replace(/\s+/g, "").length;
const readingTime = Math.max(1, Math.round(charCount / 400));

// Build sorted post list for prev/next navigation
const allPosts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const currentIdx = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIdx < allPosts.length - 1 ? allPosts[currentIdx + 1] : null;
const nextPost = currentIdx > 0 ? allPosts[currentIdx - 1] : null;

// Related posts by tag overlap (max 3)
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    overlap: p.data.tags.filter((t: string) => post.data.tags.includes(t)).length,
  }))
  .filter((r) => r.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3)
  .map((r) => r.post);
---

<BaseLayout pageTitle={post.data.title} pageDescription={post.data.description}>
  <div class="post-layout">
    <article class="post">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.published.toISOString()}>
            {post.data.published.toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
            })}
          </time>
          {post.data.updated && (
            <span class="post-updated">
              updated {post.data.updated.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
            </span>
          )}
          <span class="post-reading-time">{readingTime} min read</span>
          {post.data.category && (
            <a href={`/categories/${post.data.category}`} class="post-category">
              {post.data.category}
            </a>
          )}
          {post.data.tags.length > 0 && (
            <span class="post-tags">
              {post.data.tags.map((tag: string) => <a href={`/tags/${tag.toLowerCase()}`} class="tag">#{tag}</a>)}
            </span>
          )}
        </div>
      </header>

      <div class="post-body">
        <Content />
      </div>

      {(prevPost || nextPost) && (
        <nav class="post-nav">
          {prevPost ? (
            <a href={`/posts/${prevPost.id}`} class="post-nav-link prev">
              <span class="post-nav-label">&larr; Previous</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : <span />}
          {nextPost ? (
            <a href={`/posts/${nextPost.id}`} class="post-nav-link next">
              <span class="post-nav-label">Next &rarr;</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}

      {relatedPosts.length > 0 && (
        <section class="related-posts">
          <h2 class="related-heading">Related</h2>
          <ul class="related-list">
            {relatedPosts.map((rp) => (
              <li>
                <a href={`/posts/${rp.id}`}>{rp.data.title}</a>
                <span class="related-tags">
                  {rp.data.tags
                    .filter((t: string) => post.data.tags.includes(t))
                    .map((t: string) => <span class="related-tag">#{t}</span>)}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside class="post-sidebar">
      <TableOfContents {headings} />
    </aside>
  </div>
  <CommentSection />
  <BackToTop />
</BaseLayout>

<script>
  // Inject heading anchor links
  document.querySelectorAll(".post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6").forEach((h) => {
    if (!h.id) return;
    if (h.querySelector(".heading-anchor")) return; // already injected
    const a = document.createElement("a");
    a.className = "heading-anchor";
    a.href = `#${h.id}`;
    a.setAttribute("aria-label", "Link to this heading");
    a.textContent = "#";
    h.prepend(a);
  });
</script>

<style>
  .post-layout {
    position: relative;
  }

  .post-sidebar {
    position: fixed;
    top: 9rem;
    left: calc(50% + 400px + 2rem);
    width: 200px;
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-header h1 {
    font-size: 1.7rem;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .post-reading-time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .post-category {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
  }

  .post-category:hover {
    text-decoration: underline;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    transition: opacity 0.15s;
  }

  .tag:hover {
    opacity: 0.7;
    text-decoration: none;
  }

  .post-body {
    margin-top: 1.5rem;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    color: var(--color-text);
    transition: border-color 0.15s;
  }

  .post-nav-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .post-nav-link.prev {
    align-items: flex-start;
  }

  .post-nav-link.next {
    align-items: flex-end;
    text-align: right;
  }

  .post-nav-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .post-nav-title {
    font-size: 0.9rem;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 2rem;
    }

    .post-nav-link.next {
      align-items: flex-start;
      text-align: left;
    }

    .post-nav-title {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.4rem;
    }

    .post-meta {
      gap: 0.5rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 1100px) {
    .post-sidebar {
      display: none;
    }
  }

  /* ── Updated date ── */
  .post-updated {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    font-style: italic;
  }

  /* ── Related posts ── */
  .related-posts {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    transition: border-color 0.3s;
  }

  .related-heading {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .related-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .related-list a {
    font-size: 0.92rem;
    color: var(--color-accent);
  }

  .related-list a:hover {
    text-decoration: underline;
  }

  .related-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .related-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .related-posts {
      margin-top: 1.5rem;
      padding-top: 1rem;
    }

    .related-list a {
      font-size: 0.88rem;
    }
  }
</style>
