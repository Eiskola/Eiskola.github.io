---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="404">
  <div class="not-found">
    <p class="nf-code">404</p>
    <p class="nf-text">Page not found.</p>
    <a href="/" class="nf-link">&larr; Back to home</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 0;
  }

  .nf-code {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-muted);
    margin: 0;
    line-height: 1;
  }

  .nf-text {
    margin: 1rem 0 2rem;
    color: var(--color-muted);
  }

  .nf-link {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .not-found {
      padding: 2rem 0;
    }

    .nf-code {
      font-size: 3rem;
    }
  }
</style>
