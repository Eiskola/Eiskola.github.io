---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = await getCollection("posts");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

// Group by year
const byYear: Record<string, typeof posts> = {};
for (const post of posts) {
  const year = post.data.published.getFullYear().toString();
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(post);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

// Tags
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const key = tag.toLowerCase();
    tagMap.set(key, (tagMap.get(key) || 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout>
  <article class="archive">
    <h1>Archive</h1>

    {years.map((year) => (
      <section class="year-group">
        <h2>{year}</h2>
        <ul class="year-posts">
          {byYear[year].map((post) => (
            <li>
              <time datetime={post.data.published.toISOString()}>
                {post.data.published.toLocaleDateString("zh-CN", {
                  month: "2-digit",
                  day: "2-digit",
                })}
              </time>
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <hr />

    <h2>Tags</h2>
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a href={`/tags/${tag.toLowerCase()}`} class="tag-item">
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </div>
  </article>
</BaseLayout>

<style>
  .archive h1 {
    margin-top: 0;
  }

  .archive h2 {
    font-size: 1.2rem;
    color: var(--color-muted);
    margin: 2rem 0 0.75rem;
    font-weight: 500;
  }

  .year-posts {
    list-style: none;
    padding: 0;
  }

  .year-posts li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.3rem 0;
  }

  .year-posts time {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .year-posts a {
    color: var(--color-text);
  }

  .year-posts a:hover {
    color: var(--color-accent);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: border-color 0.15s, color 0.15s;
  }

  .tag-item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }

  .tag-name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>
