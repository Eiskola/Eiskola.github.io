---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tagSet = new Set<string>();
  for (const post of posts) {
    if (post.data.draft) continue;
    for (const tag of post.data.tags) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const allPosts = await getCollection("posts");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .filter((p) => p.data.tags.some((t) => t === tag))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout pageTitle={`标签：#${tag}`}>
  <article class="tag-page">
    <h1>#{tag}</h1>
    <p class="tag-subtitle">{posts.length} 篇文章</p>

    <ul class="tag-posts">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}`}>
            <time datetime={post.data.published.toISOString()}>
              {post.data.published.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
              })}
            </time>
            <span class="post-title">{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .tag-page h1 {
    margin-top: 0;
    font-family: var(--font-mono);
  }

  .tag-subtitle {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0.25rem 0 2rem;
  }

  .tag-posts {
    list-style: none;
    padding: 0;
  }

  .tag-posts li {
    margin-bottom: 0.75rem;
  }

  .tag-posts a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    color: var(--color-text);
  }

  .tag-posts a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .tag-posts time {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
