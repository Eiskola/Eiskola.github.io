---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const catMap = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.draft) continue;
  const cat = post.data.category;
  if (cat) catMap.set(cat, (catMap.get(cat) || 0) + 1);
}
const categories = [...catMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

{categories.length > 0 && (
  <nav class="cat-sidebar">
    <span class="cat-title">Categories</span>
    <ul>
      {categories.map(([cat, count]) => (
        <li>
          <a href={`/categories/${cat}`}>
            {cat}
            <span class="cat-count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .cat-sidebar {
    position: fixed;
    top: 9rem;
    bottom: 2rem;
    /* Anchor the right edge to the article column and let the bar shrink into
       the left gutter, instead of being clipped once the viewport narrows. */
    right: calc(50% + 400px + 2rem);
    width: clamp(120px, calc(50% - 440px), 160px);
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .cat-title {
    flex: none;
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  /* Its own scrollport, so a long category list scrolls under the pinned title
     rather than running off the bottom of the viewport. */
  .cat-sidebar ul {
    flex: 1 1 auto;
    min-height: 0;
    list-style: none;
    padding: 0.1rem 0.35rem 0.25rem 0;
    margin: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .cat-sidebar ul::-webkit-scrollbar {
    width: 6px;
  }

  .cat-sidebar ul::-webkit-scrollbar-track {
    background: transparent;
  }

  .cat-sidebar ul::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 999px;
  }

  .cat-sidebar ul:hover::-webkit-scrollbar-thumb {
    background: var(--color-muted);
  }

  .cat-sidebar li {
    margin: 0.25rem 0;
  }

  .cat-sidebar a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .cat-sidebar a:hover {
    color: var(--color-accent);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  @media (max-width: 1150px) {
    .cat-sidebar {
      display: none;
    }
  }
</style>
