---
import type { MarkdownHeading } from "astro";
import { tocConfig } from "../config";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

function cleanHeadingText(text: string): string {
  // Strip $...$ and $$...$$ math
  text = text.replace(/\$\$?[^$]+\$\$?/g, "");
  // Strip leaked KaTeX artifacts: \command{...}, ${...}, \command
  text = text.replace(/\\[a-z]+\{[^}]*\}/gi, "");
  text = text.replace(/\$\{[^}]*\}/g, "");
  text = text.replace(/\\[a-z]+/gi, "");
  // Collapse whitespace
  text = text.replace(/\s+/g, " ").trim();
  return text;
}

const items = headings
  .filter((h) => h.depth >= tocConfig.minDepth && h.depth <= tocConfig.maxDepth)
  .map((h) => ({ ...h, text: cleanHeadingText(h.text) }));
---

{items.length > 0 && (
  <nav class="toc" id="toc">
    <span class="toc-title">Outline</span>
    <ul class="toc-list">
      {items.map((h) => (
        <li class={`toc-depth-${h.depth}`}>
          <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .toc-title {
    flex: none;
    display: block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  /* The list is its own scrollport, so a long outline scrolls under a pinned
     title instead of running off the bottom of the viewport. The negative
     margin + matching padding keep the active bar (which lives in `a`'s
     negative margin) inside the visible padding box. */
  .toc-list {
    flex: 1 1 auto;
    min-height: 0;
    list-style: none;
    margin: 0 0 0 -0.75rem;
    padding: 0.1rem 0.35rem 0.25rem 0.75rem;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .toc-list::-webkit-scrollbar {
    width: 6px;
  }

  .toc-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 999px;
  }

  .toc-list:hover::-webkit-scrollbar-thumb {
    background: var(--color-muted);
  }

  .toc li {
    margin: 0.25rem 0;
  }

  .toc a {
    display: block;
    color: var(--color-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 0.6rem;
    margin-left: -0.6rem;
    transition: color 0.15s, border-color 0.15s;
  }

  .toc a:hover {
    color: var(--color-accent);
  }

  .toc a.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .toc-depth-3 {
    padding-left: 1rem;
  }
</style>

<script>
  function setActive(links: NodeListOf<HTMLAnchorElement>, id: string) {
    links.forEach((a) => {
      a.classList.toggle("active", a.dataset.tocLink === id);
    });
  }

  function initToc() {
    const nav = document.getElementById("toc");
    if (!nav || nav.dataset.tocReady === "true") return;

    const list = nav.querySelector<HTMLElement>(".toc-list");
    const links = nav.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (!list || links.length === 0) return;
    nav.dataset.tocReady = "true";

    const linkById = new Map<string, HTMLAnchorElement>();
    const headingEls: HTMLElement[] = [];
    links.forEach((a) => {
      const id = a.dataset.tocLink!;
      linkById.set(id, a);
      const el = document.getElementById(id);
      if (el) headingEls.push(el);
    });

    if (headingEls.length === 0) return;

    // ── Track the current section ────────────────────────────────────────
    // Derived from scroll position rather than an IntersectionObserver: a jump
    // (anchor click, PageDown, restored scroll position) never moves a heading
    // *through* the observer band, so its ratio stays 0 and nothing is
    // reported — the highlight would silently go stale.
    const READING_LINE = 80; // px below the viewport top
    let activeId = "";

    function currentHeadingId(): string {
      let id = headingEls[0].id;
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top > READING_LINE) break;
        id = el.id;
      }
      // At the very bottom, the last section is being read even though its
      // heading may never reach the reading line.
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        id = headingEls[headingEls.length - 1].id;
      }
      return id;
    }

    // ── Keep the active entry visible ────────────────────────────────────
    // While the reader scrolls the article, the outline follows along so the
    // current section stays in view. Driving the outline itself holds that
    // off; the moment the reader scrolls the article again, the hold is
    // released and the outline snaps back to the current section.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let manualHold = false;
    let selfScrollTimer = 0;

    function markSelfScroll() {
      clearTimeout(selfScrollTimer);
      selfScrollTimer = window.setTimeout(() => {
        selfScrollTimer = 0;
      }, 400);
    }

    function reveal(link: HTMLElement) {
      if (manualHold) return;
      if (list.scrollHeight <= list.clientHeight + 1) return;

      const listRect = list.getBoundingClientRect();
      const itemRect = link.getBoundingClientRect();
      // Already fully visible: leave the outline where it is.
      if (itemRect.top >= listRect.top && itemRect.bottom <= listRect.bottom) return;

      // Park the entry about a third from the top so neighbours stay in view.
      const target =
        list.scrollTop + (itemRect.top - listRect.top) - Math.max(24, list.clientHeight * 0.33);
      const max = list.scrollHeight - list.clientHeight;

      markSelfScroll();
      list.scrollTo({
        top: Math.min(Math.max(target, 0), max),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    }

    function setCurrent(id: string) {
      if (id === activeId) return;
      activeId = id;
      setActive(links, id);
      const link = linkById.get(id);
      if (link) reveal(link);
    }

    function suspend() {
      manualHold = true;
    }

    // Scrolling the outline itself is a deliberate act: leave it where it is.
    // `overscroll-behavior: contain` keeps these gestures from also scrolling
    // the article, so the two signals never get confused.
    list.addEventListener("wheel", suspend, { passive: true });
    list.addEventListener("touchstart", suspend, { passive: true });
    list.addEventListener("pointerdown", suspend, { passive: true });
    list.addEventListener(
      "scroll",
      () => {
        if (selfScrollTimer) {
          // Our own smooth scroll is still emitting events.
          markSelfScroll();
          return;
        }
        suspend();
      },
      { passive: true }
    );

    // Click: highlight immediately, the scroll handler confirms afterwards
    links.forEach((a) => {
      a.addEventListener("click", () => setCurrent(a.dataset.tocLink!));
    });

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const id = currentHeadingId();
        const wasHeld = manualHold;
        // The reader is scrolling the article again: following resumes, and the
        // outline catches up with the section being read right away.
        if (wasHeld) manualHold = false;
        setCurrent(id);
        if (wasHeld) {
          const link = linkById.get(activeId);
          if (link) reveal(link);
        }
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    setCurrent(currentHeadingId());
  }

  initToc();
  document.addEventListener("astro:page-load", initToc);
</script>
